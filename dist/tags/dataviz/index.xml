      <title>My Leaflet Map Post</title>
      <link>http://localhost:1313/posts/dataviz/test_leaflet/</link>
      <pubDate>Wed, 30 Jul 2025 00:00:00 +0000</pubDate>
      
      <guid>http://localhost:1313/posts/dataviz/test_leaflet/</guid>
      <description>&lt;p&gt;This post shows a simple map:&lt;/p&gt;
&lt;div id=&#34;mymap&#34; style=&#34;height: 400px&#34;&gt;&lt;/div&gt;

&lt;link rel=&#34;stylesheet&#34; href=&#34;https://unpkg.com/leaflet/dist/leaflet.css&#34; /&gt;
&lt;script src=&#34;https://unpkg.com/leaflet/dist/leaflet.js&#34;&gt;&lt;/script&gt;

&lt;script&gt;
  document.addEventListener(&#34;DOMContentLoaded&#34;, function () {
    var map = L.map(&#39;mymap&#39;).setView([&#34;48.8566&#34;, &#34;2.3522&#34;], &#34;13&#34;);
    L.tileLayer(&#39;https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png&#39;, {
      maxZoom: 19,
      attribution: &#39;&amp;copy; OpenStreetMap contributors&#39;
    }).addTo(map);
    L.marker([&#34;48.8566&#34;, &#34;2.3522&#34;]).addTo(map);
  });
&lt;/script&gt;</description>
    </item>
    
    <item>
      <title>Spider Map</title>
      <link>http://localhost:1313/posts/dataviz/spider-map/</link>
      <pubDate>Mon, 08 Jun 2020 08:06:25 +0600</pubDate>
      
      <guid>http://localhost:1313/posts/dataviz/spider-map/</guid>
      <description>&lt;p&gt;Creating a spidermap to display the five elements closest to a point on the map.&lt;/p&gt;
&lt;div id=&#34;spider&#34; style=&#34;height: 800px&#34;&gt;&lt;/div&gt;

    &lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css&#34; /&gt;
    &lt;style&gt;
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: Arial, sans-serif;
        }
        #map {
          height: 100vh;
          width: 100vw;
          position: relative;
          overflow: hidden;
        }

 


        &lt;/style&gt;
     

    &lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js&#34;&gt;&lt;/script&gt;
    &lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js&#34;&gt;&lt;/script&gt;
    &lt;script&gt;
        
        

        
        var map = L.map(&#39;spider&#39;).setView([&#34;48.8566&#34;, &#34;2.3522&#34;], &#34;13&#34;);
        
        
        L.tileLayer(&#39;https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png&#39;, {
            attribution: &#39;© OpenStreetMap contributors&#39;
        }).addTo(map);


        const crossIcon = L.divIcon({
          className: &#39;&#39;, 
          html: `
            &lt;svg width=&#34;20&#34; height=&#34;20&#34; viewBox=&#34;0 0 20 20&#34;&gt;
              &lt;line x1=&#34;0&#34; y1=&#34;10&#34; x2=&#34;20&#34; y2=&#34;10&#34; stroke=&#34;green&#34; stroke-width=&#34;3&#34;/&gt;
              &lt;line x1=&#34;10&#34; y1=&#34;0&#34; x2=&#34;10&#34; y2=&#34;20&#34; stroke=&#34;green&#34; stroke-width=&#34;3&#34;/&gt;
            &lt;/svg&gt;
          `,
          iconSize: [20, 20],
          iconAnchor: [10, 10] 
        });



        let locationData = []; 

        
        fetch(&#39;/data/data_paris.json&#39;)
          .then(response =&gt; {
            if (!response.ok) {
              throw new Error(`HTTP error: ${response.status}`);
            }
            return response.json();
          })
          .then(data =&gt; {
            

            
            locationData = data.filter(item =&gt;
              item.lat &amp;&amp; item.lon &amp;&amp;
              item.lat &gt;= 48.7 &amp;&amp; item.lat &lt;= 49.0 &amp;&amp;
              item.lon &gt;= 2.2 &amp;&amp; item.lon &lt;= 2.5
            );

            console.log(`Loaded ${locationData.length} valid data points`);
            
            
            if (locationData.length &gt; 0) {
                map.setView([48.86040527639665, 2.3413621712967085], 14);
            }
            
            
            startSpiderMap();
          })
          .catch(error =&gt; {
            console.error(&#39;Error loading JSON:&#39;, error);
            alert(&#39;Error loading data.json. Please make sure the file exists and is accessible.&#39;);

            startSpiderMap();

          });





        
        
        
            
        
        
        
        
        
        
        
            
        
            
        
        
        
        
            
        
        
            
        
        
        
            
          
            
        
        

        
        function startSpiderMap() {
            
            let spiderLines = [];
            let activeMarkers = [];
            let updateInterval;
            console.log(&#39;startSpiderMap&#39;);

            const center = map.getCenter();
            const crossMarker = L.marker(center, { icon: crossIcon, interactive: false }).addTo(map);

            
            function calculateDistance(lat1, lon1, lat2, lon2) {
                const R = 6371; 
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lon2 - lon1) * Math.PI / 180;
                const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                          Math.sin(dLon/2) * Math.sin(dLon/2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                return R * c;
            }


            
            function findNearestPoints(centerLat, centerLon) {
                const distances = [];
                
                locationData.forEach(item =&gt; {
                    if (item.lat &amp;&amp; item.lon) {
                        const distance = calculateDistance(centerLat, centerLon, item.lat, item.lon);
                        distances.push({
                            ...item,
                            distance: distance
                        });
                    }
                });
                
                
                return distances.sort((a, b) =&gt; a.distance - b.distance).slice(0, 5);
            }

            
            function clearSpiderElements() {
                spiderLines.forEach(line =&gt; map.removeLayer(line));
                activeMarkers.forEach(marker =&gt; map.removeLayer(marker));
                spiderLines = [];
                activeMarkers = [];
            }

            
            function updateSpiderMap() {
                const center = map.getCenter();
                const centerLat = center.lat;
                const centerLon = center.lng;

                crossMarker.setLatLng(map.getCenter());
                
                clearSpiderElements();

                
                const nearestPoints = findNearestPoints(centerLat, centerLon);
                
                
                nearestPoints.forEach(point =&gt; {
                    
                    const line = L.polyline([
                        [centerLat, centerLon],
                        [point.lat, point.lon]
                    ], {
                        color: &#39;red&#39;,
                        weight: 2,
                        opacity: 0.8
                    }).addTo(map);
                    spiderLines.push(line);

                    
                    const marker = L.circleMarker([point.lat, point.lon], {
                        color: &#39;blue&#39;,
                        fillColor: &#39;blue&#39;,
                        fillOpacity: 0.8,
                        radius: 4
                    }).addTo(map);

                    
                    
                    const popupContent = Object.keys(point)
                        .filter(key =&gt; key !== &#39;lat&#39; &amp;&amp; key !== &#39;lon&#39; &amp;&amp; key !== &#39;distance&#39;)
                        .map(key =&gt; `${key}: ${point[key]}`)
                        .join(&#39;&lt;br&gt;&#39;);
                    marker.bindPopup(popupContent);
                    
                    activeMarkers.push(marker);
                });
                

            }

            
            
            updateSpiderMap();

            
            updateInterval = setInterval(updateSpiderMap, 200);

            
            map.on(&#39;move&#39;, updateSpiderMap);
            map.on(&#39;zoom&#39;, updateSpiderMap);

            
            window.addEventListener(&#39;beforeunload&#39;, () =&gt; {
                if (updateInterval) {
                    clearInterval(updateInterval);
                }
            });
        }

        
        
        
        
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
&lt;h1 id=&#34;background&#34;&gt;Background&lt;/h1&gt;
